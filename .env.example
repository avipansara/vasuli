# Copy to .env and fill in values from Supabase: Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Project URL (Config → URL)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon public key (Config → Project API keys → anon public)
# Safe to embed in the app when Row Level Security (RLS) is enforced.
# Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# Optional: legacy email/password auth path in auth-context.tsx
# EXPO_PUBLIC_USE_SUPABASE=true

# Optional: OTP / local testing (see services/otp-service.ts)
# EXPO_PUBLIC_USE_MOCK_DATA=true
# EXPO_PUBLIC_TEST_ACCOUNT_EMAIL=
# EXPO_PUBLIC_TEST_ACCOUNT_PHONE=
# EXPO_PUBLIC_TEST_ACCOUNT_2_EMAIL=
# EXPO_PUBLIC_TEST_ACCOUNT_2_PHONE=
# EXPO_PUBLIC_TEST_ACCOUNT_OTP=
# EXPO_PUBLIC_APP_REVIEWER_EMAIL=
# EXPO_PUBLIC_APP_REVIEWER_OTP=

# Product analytics (PostHog). Client-visible project configuration, not secrets.
# Development builds stay disabled regardless. Preview and production use
# separate PostHog projects configured via EAS environment variables — never
# NODE_ENV. Each EAS environment sets its own project token plus
# EXPO_PUBLIC_APP_ENV=preview (preview) or =production (production).
# EXPO_PUBLIC_APP_ENV=preview
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EXPO_PUBLIC_POSTHOG_ENABLED=true
