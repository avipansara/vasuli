{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./deno-shim.d.ts"]
}
