{
  "name": "expo-template-default",
  "license": "0BSD",
  "main": "expo-router/entry",
  "version": "54.0.0",
  "scripts": {
    "start": "expo start",
    "start:prod": "node scripts/start-production.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck:supabase": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build:ios": "node scripts/e2e-build.cjs",
    "e2e:cleanup": "node scripts/e2e-cleanup.cjs",
    "e2e:ios:smoke": "node scripts/tester-army-run.cjs --target ios tester-e2e/account-and-static-routes.e2e.ts",
    "e2e:ios": "node scripts/tester-army-run.cjs --target ios",
    "precommit": "npm run lint && npm run typecheck:supabase && npm run test",
    "db:migrate:dev": "node scripts/migrate-dev.cjs",
    "db:promote:prod": "node scripts/promote-migrations.cjs",
    "draft": "npx eas-cli@latest workflow:run create-draft.yml",
    "development-builds": "npx eas-cli@latest workflow:run create-development-builds.yml",
    "deploy": "npx eas-cli@latest workflow:run deploy-to-production.yml",
    "supabase:deploy:send-invitation": "supabase functions deploy send-invitation --no-verify-jwt",
    "supabase:deploy:send-push-notification": "supabase functions deploy send-push-notification --no-verify-jwt",
    "supabase:deploy:delete-account": "supabase functions deploy delete-account",
    "supabase:deploy:process-analytics-deletion-retries": "supabase functions deploy process-analytics-deletion-retries --no-verify-jwt",
    "supabase:deploy:verify-test-otp": "supabase functions deploy verify-test-otp --no-verify-jwt",
    "prepare": "husky",
    "e2e": "node scripts/tester-army-run.cjs",
    "e2e:android": "node scripts/tester-army-run.cjs --target android",
    "e2e:list": "npx e2e list",
    "e2e:detox": "node scripts/e2e-run.cjs",
    "e2e:detox:smoke": "E2E_INCLUDE_SMOKE=1 node scripts/e2e-run.cjs e2e/smoke.test.js",
    "e2e:build:android": "E2E_PLATFORM=android node scripts/e2e-build.cjs",
    "e2e:tester-army": "node scripts/tester-army-run.cjs",
    "e2e:tester-army:list": "npx e2e list"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@posthog/react-native-plugin": "^2.5.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.100.10",
    "@types/qrcode": "^1.5.6",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "posthog-react-native": "^4.68.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "^0.12.6",
    "@posthog/cli": "^0.18.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "e2e": "^0.23.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "supabase": "^2.116.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
