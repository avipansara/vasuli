{
  "name": "expo-template-default",
  "license": "0BSD",
  "main": "expo-router/entry",
  "version": "54.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck:supabase": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build:ios": "node scripts/e2e-build.cjs",
    "e2e:cleanup": "node scripts/e2e-cleanup.cjs",
    "e2e:ios:smoke": "E2E_INCLUDE_SMOKE=1 node scripts/e2e-run.cjs e2e/smoke.test.js",
    "e2e:ios": "node scripts/e2e-run.cjs",
    "precommit": "npm run lint && npm run typecheck:supabase && npm run test",
    "draft": "npx eas-cli@latest workflow:run create-draft.yml",
    "development-builds": "npx eas-cli@latest workflow:run create-development-builds.yml",
    "deploy": "npx eas-cli@latest workflow:run deploy-to-production.yml",
    "supabase:deploy:send-invitation": "supabase functions deploy send-invitation --no-verify-jwt",
    "supabase:deploy:send-push-notification": "supabase functions deploy send-push-notification --no-verify-jwt",
    "supabase:deploy:delete-account": "supabase functions deploy delete-account",
    "supabase:deploy:verify-test-otp": "supabase functions deploy verify-test-otp --no-verify-jwt",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.100.10",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.13",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.1",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "detox": "^20.51.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "happy-dom": "^20.8.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supabase": "^2.101.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
